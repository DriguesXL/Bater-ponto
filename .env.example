# ==========================================
# SISTEMA DE CONTROLE DE PONTO - CONFIGURAÇÕES
# ==========================================

# Porta do Servidor Web
PORT=3000

# Chave secreta para geração de tokens JWT
JWT_SECRET=super_secret_jwt_key_troque_em_producao_2026_xyz!

# Banco de dados: Escolha 'postgres' ou 'sqlite'
# Por padrão, usa 'sqlite' para funcionar de imediato localmente,
# ou 'postgres' se você fornecer as credenciais do PostgreSQL.
DB_CLIENT=sqlite

# Configurações do PostgreSQL (usadas se DB_CLIENT=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pontodb
PG_USER=postgres
PG_PASSWORD=suasenhadopostgres
# Ou URL completa de conexão (ex: Supabase, Neon, Railway, Docker):
# DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/pontodb

# ==========================================
# CONFIGURAÇÃO DE E-MAILS (NODEMAILER / SMTP)
# ==========================================
# E-mail do administrador que receberá os relatórios e comprovantes
ADMIN_NOTIFICATION_EMAIL=admin@empresa.com.br

# Provedor SMTP (ex: smtp.gmail.com, smtp.office365.com, smtp.mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_smtp
SMTP_FROM="Sistema de Ponto <nao-responda@empresa.com.br>"

# Agendamento do Relatório Diário por e-mail (Formato Cron: Todos os dias às 20:00)
DAILY_REPORT_CRON="0 20 * * 1-5"
